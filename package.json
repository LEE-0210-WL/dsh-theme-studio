{
    "name":  "dsh-theme-studio",
    "version":  "0.2.1",
    "private":  true,
    "description":  "自定义壁纸、玻璃质感与强调色 — Wallpaper, glass and accent customisation for the DSH Web GUI",
    "type":  "module",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [

                                          ]
                           }
            },
    "license":  "MIT"
}
